# Postgres (Railway public URL; on Vercel add ?sslmode=no-verify — Railway's certificate is self-signed)
DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# report days are counted in this time zone (default Asia/Manila)
REPORT_TIMEZONE=Asia/Manila

# only for `npm run seed`
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
